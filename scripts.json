{
  "scripts": [
    {
      "name": "redirector",
      "path": "redirector/redirector.js",
      "match": [
        "*://*/*"
      ],
      "runAt": "document-start",
      "enabled": true
    },
    {
      "name": "example-banner",
      "path": "example/banner.js",
      "match": [
        "*://example.com/*"
      ],
      "runAt": "document-idle",
      "enabled": true
    }
  ]
}
